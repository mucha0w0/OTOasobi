<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Otoasobi.Probe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="オトアソビ — OTOasobi">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="DragRegion" Padding="16,0,0,0">
            <TextBlock
                x:Name="CaptionText"
                VerticalAlignment="Center"
                FontSize="13"
                Text="オトアソビ" />
        </Grid>
        <WebView2 x:Name="View" Grid.Row="1" />
        <TextBlock
            x:Name="MissingRuntime"
            Grid.Row="1"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</Window>
