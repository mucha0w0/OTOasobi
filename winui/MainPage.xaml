<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Otoasobi.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Otoasobi"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Button
                x:Name="IdleView"
                Content="フォルダを選択またはドラッグ＆ドロップ"
                FontSize="20"
                Padding="28,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="IdleView_Click" />

            <TextBlock
                x:Name="BusyView"
                Text="解析中..."
                FontSize="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />

            <Grid x:Name="EditorView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="16,12,16,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="FolderLabel"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        FontSize="14" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="無音" Foreground="#FF9AA0A6" VerticalAlignment="Center" />
                            <TextBlock Text="息" Foreground="#FF60A5FA" VerticalAlignment="Center" />
                            <TextBlock Text="子音" Foreground="#FFD97706" VerticalAlignment="Center" />
                            <TextBlock Text="母音" Foreground="#FF0F9D8E" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="縮小" Click="ZoomOut_Click" />
                        <Button Content="拡大" Click="ZoomIn_Click" />
                        <Button Content="全体" Click="ZoomReset_Click" />
                        <Button Content="フォルダを選択" Click="IdleView_Click" />
                        <Button x:Name="OpenButton" Content="oto.iniを開く" Click="OpenTxt_Click" IsEnabled="False" />
                        <Button
                            x:Name="WriteButton"
                            Content="oto.ini作成"
                            Click="WriteOto_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer
                    x:Name="BannerHost"
                    Grid.Row="1"
                    MaxHeight="96"
                    Margin="16,0,16,8"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <TextBlock x:Name="Banner" TextWrapping="Wrap" />
                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0">
                        <ListView
                            x:Name="FileList"
                            SelectionMode="Single"
                            SelectionChanged="FileList_SelectionChanged"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="FileCaption"
                            Margin="12,4,12,4"
                            FontSize="14"
                            TextTrimming="CharacterEllipsis" />
                        <local:SpanEditor x:Name="Editor" Grid.Row="1" Margin="8,0,8,8" />
                    </Grid>
                </Grid>
            </Grid>

            <TextBlock
                x:Name="ErrorView"
                FontSize="18"
                TextAlignment="Center"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                Tapped="ErrorView_Tapped"
                Visibility="Collapsed" />
        </Grid>

        <Border
            x:Name="StatusBar"
            Grid.Row="1"
            Padding="16,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="StatusProgress"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="1" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14" />
            </Grid>
        </Border>
    </Grid>
</Page>
