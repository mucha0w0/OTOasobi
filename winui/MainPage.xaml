<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Otoasobi.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Otoasobi"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <x:String x:Key="EditorHelp">上の波形では境界をドラッグして時刻を分けます。音量の下に出る oto.ini のラベルはドラッグできません。右ドラッグ、または選択中の左右キーでスクロールします。</x:String>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolbarAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OverlapValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="OverlapGroupStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <MenuBar VerticalAlignment="Center" Padding="4,0">
                <MenuBarItem Title="ファイル">
                    <MenuFlyoutItem
                        x:Name="OpenMenuItem"
                        Text="フォルダを開く"
                        Click="IdleView_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="WriteMenuItem"
                        Text="oto.iniを作成"
                        Click="WriteOto_Click"
                        IsEnabled="False">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="終了" Click="Exit_Click" />
                </MenuBarItem>
                <MenuBarItem Title="解析">
                    <MenuFlyoutItem
                        x:Name="ReanalyzeMenuItem"
                        Text="再解析"
                        Click="Reanalyze_Click"
                        IsEnabled="False" />
                    <MenuFlyoutItem
                        x:Name="ReanalyzeSelectedMenuItem"
                        Text="選択した音声だけを再解析"
                        Click="ReanalyzeSelected_Click"
                        IsEnabled="False" />
                </MenuBarItem>
            </MenuBar>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel
                x:Name="IdleView"
                MaxWidth="440"
                Padding="24"
                Spacing="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Viewbox Width="40" Height="40" Margin="0,0,0,8" HorizontalAlignment="Center">
                    <SymbolIcon Symbol="Folder" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Viewbox>
                <TextBlock
                    Text="音源フォルダを開く"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    Margin="0,0,0,8"
                    Text="フォルダを開くと編集画面に入ります。保存データがあるときは、その区間を読み込みます。無いときは、解析してから区間を直せます。フォルダをこのウィンドウへドロップしても開けます。"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    MinWidth="160"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="IdleView_Click"
                    Content="フォルダを開く"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <StackPanel
                x:Name="BusyView"
                MaxWidth="360"
                Spacing="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <ProgressRing
                    x:Name="BusyRing"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="解析しています"
                    IsActive="False" />
                <TextBlock
                    x:Name="BusyTitle"
                    Text="読み込んでいます"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <ProgressBar
                    x:Name="BusyProgress"
                    AutomationProperties.Name="解析の進行状況"
                    Minimum="0"
                    Maximum="1" />
                <TextBlock
                    x:Name="BusyCount"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid x:Name="EditorView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="FolderLabel"
                    Grid.Row="0"
                    Margin="16,8,16,0"
                    AutomationProperties.Name="開いているフォルダ"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />

                <ScrollViewer
                    x:Name="NoticeHost"
                    Grid.Row="1"
                    MaxHeight="132"
                    Margin="16,8,16,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <InfoBar
                        x:Name="NoticeBar"
                        HorizontalAlignment="Stretch"
                        IsClosable="True"
                        IsOpen="False"
                        Closed="NoticeBar_Closed" />
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Padding="16,12,16,8"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="ファイル" />
                                    <TextBlock
                                        x:Name="FileCount"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                            </Border>
                            <ListView
                                x:Name="FileList"
                                Grid.Row="1"
                                AutomationProperties.Name="ファイル一覧"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="FileList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="FileTitle"
                            Margin="16,8,16,8"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <local:SpanEditor
                            x:Name="Editor"
                            Grid.Row="1"
                            Margin="12,0,12,4"
                            AutomationProperties.Name="波形と区間"
                            AutomationProperties.HelpText="{StaticResource EditorHelp}" />
                    </Grid>
                    <Border
                        Grid.Column="2"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0">
                        <TabView
                            IsAddTabButtonVisible="False"
                            CanDragTabs="False"
                            CanReorderTabs="False"
                            AllowDropTabs="False"
                            TabWidthMode="Equal">
                            <TabViewItem
                                Header="oto調整"
                                IsClosable="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <ContentControl x:Name="ConfigBody" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel Padding="16,12,16,12" Spacing="18">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="プリセット" />
                                            <DropDownButton
                                                x:Name="PresetMenu"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                MinHeight="32"
                                                AutomationProperties.HelpText="プリセット">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock
                                                        x:Name="PresetNameText"
                                                        MaxWidth="148"
                                                        VerticalAlignment="Center"
                                                        Text="初期値"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        x:Name="PresetDirtyMark"
                                                        VerticalAlignment="Center"
                                                        Text="*"
                                                        Visibility="Collapsed"
                                                        AutomationProperties.Name="変更あり"
                                                        ToolTipService.ToolTip="このプリセットから変更しています" />
                                                </StackPanel>
                                                <DropDownButton.Flyout>
                                                    <MenuFlyout x:Name="PresetFlyout" />
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                Click="SavePreset_Click"
                                                Content="現在の設定を保存"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                ToolTipService.ToolTip="いまのスライダーの値を、名前をつけて保存します" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center" Text="オフセット" />
                                                <TextBlock
                                                    x:Name="OffsetValue"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="0.000 s" />
                                            </Grid>
                                            <Slider
                                                x:Name="OffsetSlider"
                                                AutomationProperties.Name="オフセット"
                                                Maximum="0.1"
                                                Minimum="-0.1"
                                                StepFrequency="0.001"
                                                SnapsTo="StepValues"
                                                Value="0" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center" Text="子音部" />
                                                <TextBlock
                                                    x:Name="ConsonantValue"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="0.200 s" />
                                            </Grid>
                                            <Slider
                                                x:Name="ConsonantSlider"
                                                AutomationProperties.Name="子音部"
                                                Maximum="0.2"
                                                Minimum="0"
                                                StepFrequency="0.001"
                                                SnapsTo="StepValues"
                                                Value="0.2" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <Grid>
                                                <TextBlock VerticalAlignment="Center" Text="ブランク" />
                                                <TextBlock
                                                    x:Name="BlankValue"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="0.000 s" />
                                            </Grid>
                                            <Slider
                                                x:Name="BlankSlider"
                                                AutomationProperties.Name="ブランク"
                                                Maximum="0.1"
                                                Minimum="-0.1"
                                                StepFrequency="0.001"
                                                SnapsTo="StepValues"
                                                Value="0" />
                                        </StackPanel>
                                        <StackPanel Spacing="8">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="オーバーラップ" />
                                            <StackPanel x:Name="OverlapList" Spacing="16" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel Grid.Row="1" Padding="16,8,16,16" Spacing="8">
                                    <Button
                                        x:Name="WriteButton"
                                        HorizontalAlignment="Stretch"
                                        Click="WriteOto_Click"
                                        Style="{StaticResource ToolbarAccentButtonStyle}"
                                        ToolTipService.ToolTip="直した区間から oto.ini を計算して、フォルダに保存します（Ctrl+S）">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <SymbolIcon Symbol="Save" />
                                            <TextBlock Text="oto.iniを作成" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Click="ResetConfig_Click"
                                        Content="初期値に戻す"
                                        Style="{StaticResource ToolbarButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            </ContentControl>
                            </TabViewItem>
                            <TabViewItem
                                Header="原音修正"
                                IsClosable="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                                <local:EffectRack />
                            </TabViewItem>
                        </TabView>
                    </Border>
                </Grid>
            </Grid>

            <StackPanel
                x:Name="ErrorView"
                MaxWidth="480"
                Padding="24"
                Spacing="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <Viewbox Width="32" Height="32" Margin="0,0,0,8" HorizontalAlignment="Center">
                    <SymbolIcon Symbol="Important" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </Viewbox>
                <TextBlock
                    Text="フォルダを開けませんでした"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="ErrorText"
                    Margin="0,0,0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    MinWidth="160"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="IdleView_Click"
                    Content="フォルダを開く"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="StatusBar"
            Grid.Row="2"
            Padding="16,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="StatusProgress"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="処理の進行状況"
                    IsIndeterminate="True" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border
            x:Name="FileStatusBar"
            Grid.Row="3"
            Padding="16,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="FileProgress"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="解析中ファイルの進行状況"
                    Minimum="0"
                    Maximum="1" />
                <TextBlock
                    x:Name="FileStatusText"
                    Grid.Column="1"
                    MaxWidth="480"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Page>
