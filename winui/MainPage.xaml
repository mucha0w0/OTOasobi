                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Label="その他の行"
                                                Text="「：」や「:」の無い行です。" />
                                        </Grid>
                                        <TextBox
                                            x:Name="BankExtraBox"
                                            MinWidth="0"
                                            MinHeight="72"
                                            HorizontalAlignment="Stretch"
                                            AcceptsReturn="True"
                                            AutomationProperties.Name="character.txt のその他の行"
                                            PlaceholderText="記号の無い行"
                                            TextChanged="BankForm_Changed"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel Spacing="8">
                                        <local:InfoNote
                                            Title="readme.txt"
                                            Text="ANSI（Shift_JIS）で保存します。内容は自由です。" />
                                        <TextBox
                                            x:Name="BankReadmeBox"
                                            MinWidth="0"
                                            MinHeight="140"
                                            HorizontalAlignment="Stretch"
                                            AcceptsReturn="True"
                                            AutomationProperties.Name="readme.txt"
                                            TextChanged="BankForm_Changed"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Height="1" Margin="0,8,0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <local:InfoNote
                                    Title="OPENUTAU用設定"
                                    Text="ここから下は character.yaml に保存します。このファイルは UTF-8 です。" />
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel Spacing="8">
                                        <local:InfoNote
                                            Title="エンコード"
                                            Text="character.txt、prefix.map、oto.ini を読むときの文字コードです。ファイルの内容から決めます。" />
                                        <TextBlock
                                            x:Name="BankEncodingText"
                                            IsTextSelectionEnabled="True"
                                            Text="text_file_encoding: shift_jis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel Spacing="8">
                                        <local:InfoNote
                                            Title="キャラクター情報"
                                            Text="name、image、author、web は character.txt と揃えます。どちらかを書き換えると、もう片方も同じになります。シンガータイプは UTAU です。" />
                                        <TextBlock Text="シンガータイプ" />
                                        <TextBlock Text="utau" />
                                        <TextBlock Text="名前" />
                                        <TextBox
                                            x:Name="BankYamlNameBox"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="OpenUTAU の名前"
                                            Tag="name"
                                            TextChanged="BankShared_TextChanged" />
                                        <TextBlock Text="画像ファイル名" />
                                        <TextBox
                                            x:Name="BankYamlImageBox"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="OpenUTAU の画像ファイル名"
                                            Tag="image"
                                            TextChanged="BankShared_TextChanged" />
                                        <TextBlock Text="作者" />
                                        <TextBox
                                            x:Name="BankYamlAuthorBox"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="OpenUTAU の作者"
                                            Tag="author"
                                            TextChanged="BankShared_TextChanged" />
                                        <Grid ColumnSpacing="4" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="声" />
                                            <local:InfoNote
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Label="声"
                                                Text="character.txt には無い項目です。" />
                                        </Grid>
                                        <TextBox
                                            x:Name="BankVoiceBox"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="声"
                                            PlaceholderText="声を担当した人"
                                            TextChanged="BankForm_Changed" />
                                        <TextBlock Text="バージョン" />
                                        <TextBox
                                            x:Name="BankVersionBox"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="バージョン"
                                            PlaceholderText="1.0"
                                            TextChanged="BankForm_Changed" />
                                        <TextBlock Text="配布サイト" />
                                        <TextBox
                                            x:Name="BankYamlWebBox"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="OpenUTAU の配布サイト"
                                            PlaceholderText="https://"
                                            Tag="web"
                                            TextChanged="BankShared_TextChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel Spacing="8">
                                        <local:InfoNote
                                            Title="ローカライズ名"
                                            Text="表示言語に合わせてシンガー名を変えるときに使います。" />
                                        <StackPanel x:Name="BankLocaleHost" Spacing="10" />
                                        <Button
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="ローカライズの言語を追加"
                                            Click="BankAddLocale_Click"
                                            Content="言語を追加"
                                            Style="{StaticResource ToolbarButtonStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel Spacing="8">
                                        <local:InfoNote
                                            Title="立ち絵"
                                            Text="ピアノロールに出す画像です。images/portrait.png のような、音源フォルダの中の相対パスも使えます。高さ 0 は既定で、小さい画像を 800px まで拡大しません。" />
                                        <Image
                                            x:Name="BankPortraitImage"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="立ち絵のプレビュー"
                                            Stretch="Uniform"
                                            Visibility="Collapsed" />
                                        <TextBlock
                                            x:Name="BankPortraitMissing"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="立ち絵が設定されていません"
                                            TextWrapping="Wrap" />
                                        <TextBlock Text="ファイル" />
                                        <TextBox
                                            x:Name="BankPortraitPathBox"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="立ち絵のパス"
                                            PlaceholderText="portrait.png"
                                            TextChanged="BankPortraitPath_Changed" />
                                        <Button
                                            x:Name="BankPickPortraitButton"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="立ち絵のファイルを選ぶ"
                                            Click="BankPickPortrait_Click"
                                            Content="ファイルを選ぶ"
                                            IsEnabled="False"
                                            Style="{StaticResource ToolbarButtonStyle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="不透明度" />
                                            <TextBlock
                                                x:Name="BankOpacityValue"
                                                Grid.Column="1"
                                                Style="{StaticResource OverlapValueStyle}"
                                                Text="0.67" />
                                        </Grid>
                                        <Slider
                                            x:Name="BankOpacitySlider"
                                            AutomationProperties.Name="立ち絵の不透明度"
                                            Maximum="1"
                                            Minimum="0"
                                            StepFrequency="0.01"
                                            SnapsTo="StepValues"
                                            Value="0.67"
                                            ValueChanged="BankOpacity_Changed" />
                                        <Grid ColumnSpacing="4" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="高さ" />
                                            <local:InfoNote
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Label="高さ"
                                                Text="0 は既定です。未指定のときは、高さが 800 を超える画像だけ 800 に縮みます。" />
                                        </Grid>
                                        <NumberBox
                                            x:Name="BankPortraitHeightBox"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="立ち絵の高さ"
                                            LargeChange="100"
                                            Maximum="10000"
                                            Minimum="0"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Inline"
                                            Value="0"
                                            ValueChanged="BankPortraitHeight_Changed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid x:Name="FrqEditPane">
                        <local:FrqPianoRoll
                            x:Name="FrqRoll"
                            AutomationProperties.Name="frqエディター"
                            AutomationProperties.HelpText="カーソルでドラッグすると、矩形の中の点を選びます。ペンでドラッグすると、通った点の高さを書き換えます。下の段は音程なしです。ホイールで音程、Shift＋ホイールで時間、Ctrl＋ホイールで拡大します。" />
                        <Border
                            x:Name="FrqToolBar"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Padding="2"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton
                                        x:Name="FrqToolSelect"
                                        AutomationProperties.Name="範囲選択"
                                        Checked="FrqTool_Checked"
                                        GroupName="FrqTool"
                                        IsChecked="True"
                                        Style="{StaticResource FrqToolButtonStyle}"
                                        ToolTipService.ToolTip="ドラッグした矩形の中の点を選びます。">
                                        <Viewbox Width="16" Height="16">
                                            <Path
                                                Data="M3,1 L3,13 L6.2,9.8 L9.3,14.6 L11.2,13.6 L8.1,8.8 L12.4,8.5 Z"
                                                Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Viewbox>
                                    </RadioButton>
                                    <RadioButton
                                        x:Name="FrqToolPen"
                                        AutomationProperties.Name="ペン"
                                        Checked="FrqTool_Checked"
                                        GroupName="FrqTool"
                                        Style="{StaticResource FrqToolButtonStyle}"
                                        ToolTipService.ToolTip="ドラッグで、通った点の高さを書き換えます。下の段では音程なしになります。">
                                        <Viewbox Width="16" Height="16">
                                            <Path
                                                Data="M11.5,1.2 L14.6,4.3 L6.1,12.8 L2.4,13.8 L3.4,10.1 Z"
                                                Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Viewbox>
                                    </RadioButton>
                                    </StackPanel>
                                <StackPanel
                                    x:Name="FrqOctaveBar"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                                <Button
                                    x:Name="FrqOctaveUpButton"
                                    AutomationProperties.Name="1オクターブ上げる"
                                    Click="FrqOctaveUp_Click"
                                    Content="＋12"
                                    IsEnabled="False"
                                    Style="{StaticResource FrqOctaveButtonStyle}"
                                    ToolTipService.ToolTip="選択した点を 1 オクターブ上げます。音程なしは動きません。" />
                                <Button
                                    x:Name="FrqOctaveDownButton"
                                    AutomationProperties.Name="1オクターブ下げる"
                                    Click="FrqOctaveDown_Click"
                                    Content="-12"
                                    IsEnabled="False"
                                    Style="{StaticResource FrqOctaveButtonStyle}"
                                    ToolTipService.ToolTip="選択した点を 1 オクターブ下げます。音程なしは動きません。" />
                                <Button
                                    x:Name="FrqUnvoiceButton"
                                    AutomationProperties.Name="音程なし"
                                    Click="FrqUnvoice_Click"
                                    Content="-"
                                    IsEnabled="False"
                                    Style="{StaticResource FrqOctaveButtonStyle}"
                                    ToolTipService.ToolTip="選択した点を音程なしにします。" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid x:Name="RecListPane">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Padding="12,12,12,8" Spacing="8">
                            <local:InfoNote
                                Title="録音リスト"
                                Text="1 行が 1 テイクです。空行と # で始まる行は読み飛ばし、タブの右側はコメントです。文字コードは CP932 と UTF-8 に対応します。フォルダに録音リスト.txt があれば、それを開きます。一度選んだリストは、次からこのメニューに出ます。" />
                            <TextBlock
                                x:Name="RecProgress"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="0 / 0" />
                            <Border
                                Padding="3"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="8">
                                <Grid ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton
                                        x:Name="RecFilterAll"
                                        AutomationProperties.Name="すべての行"
                                        Checked="RecFilter_Checked"
                                        Content="すべて"
                                        GroupName="RecFilter"
                                        IsChecked="True"
                                        Style="{StaticResource SegmentButtonStyle}"
                                        Tag="all" />
                                    <RadioButton
                                        x:Name="RecFilterTodo"
                                        Grid.Column="1"
                                        AutomationProperties.Name="未録音の行"
                                        Checked="RecFilter_Checked"
                                        Content="未録音"
                                        GroupName="RecFilter"
                                        Style="{StaticResource SegmentButtonStyle}"
                                        Tag="todo" />
                                    <RadioButton
                                        x:Name="RecFilterDone"
                                        Grid.Column="2"
                                        AutomationProperties.Name="録音済みの行"
                                        Checked="RecFilter_Checked"
                                        Content="録音済み"
                                        GroupName="RecFilter"
                                        Style="{StaticResource SegmentButtonStyle}"
                                        Tag="done" />
                                </Grid>
                            </Border>
                            <ToggleSwitch
                                x:Name="RecPrefixSwitch"
                                AutomationProperties.Name="ファイル名に音程を付ける"
                                OffContent="ファイル名に音程を付けない"
                                OnContent="ファイル名に音程を付ける"
                                Toggled="RecPrefix_Toggled" />
                            <ComboBox
                                x:Name="RecListBox"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="録音リスト"
                                DisplayMemberPath="Label"
                                MaxDropDownHeight="320"
                                PlaceholderText="選択しない"
                                SelectionChanged="RecListBox_Changed" />
                        </StackPanel>
                        <ListView
                            x:Name="RecListView"
                            Grid.Row="1"
                            AutomationProperties.Name="録音リスト"
                            SelectionChanged="RecList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,4" Spacing="2">
                                        <TextBlock
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding Detail}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="RecListEmpty"
                            Grid.Row="1"
                            Margin="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="リストを選ぶと、ここに行が出ます。"
                            TextWrapping="Wrap" />
                    </Grid>
                    <Grid x:Name="RecPane">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Padding="12,12,12,8" Spacing="8">
                            <TextBlock
                                x:Name="RecSingText"
                                FontSize="36"
                                Text="録音リストを開いてください"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="RecCommentText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="RecNextText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="RecFileText"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="RecStatusText"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                            <TextBlock
                                x:Name="RecPrefixNote"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="ファイル名の頭に音程が付きます。この名前は、いまの解析では読めません。"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    x:Name="RecMeterTrack"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="5"
                                    SizeChanged="RecMeter_SizeChanged">
                                    <Border
                                        x:Name="RecMeterZone"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                        CornerRadius="5"
                                        Opacity="0.45" />
                                    <Border
                                        x:Name="RecMeterFill"
                                        Width="0"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="5" />
                                </Grid>
                                <TextBlock
                                    x:Name="RecLevelText"
                                    Grid.Column="1"
                                    MinWidth="52"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextAlignment="Right"
                                    ToolTipService.ToolTip="右端が 0 dB です。薄い帯は -12 dB から -6 dB です。" />
                            </Grid>
                        </StackPanel>
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="12,0,12,12" Spacing="10">
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel Spacing="8">
                                        <local:InfoNote
                                            Title="ガイド"
                                            Text="ガイド音は、音程を合わせる基準音です。ガイド音源は、同じファイル名の WAV がある別フォルダで、発音と長さを聴くためのものです。録音中に鳴らすと、スピーカーの音をマイクが拾うことがあります。" />
                                        <TextBlock Text="ガイド音源" />
                                        <ComboBox
                                            x:Name="RecGuideBox"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="ガイド音源"
                                            DisplayMemberPath="Label"
                                            MaxDropDownHeight="320"
                                            PlaceholderText="選択しない"
                                            SelectionChanged="RecGuideBox_Changed" />
                                        <TextBlock Text="音程" />
                                        <ComboBox
                                            x:Name="RecNoteBox"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="ガイドの音程"
                                            SelectionChanged="RecNote_Changed" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="ガイドの大きさ" />
                                            <TextBlock
                                                x:Name="RecVolumeValue"
                                                Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="70%" />
                                        </Grid>
                                        <Slider
                                            x:Name="RecVolumeSlider"
                                            AutomationProperties.Name="ガイドの大きさ"
                                            Maximum="100"
                                            Minimum="0"
                                            StepFrequency="1"
                                            Value="70"
                                            ValueChanged="RecVolume_Changed" />
                                        <ToggleSwitch
                                            x:Name="RecCountInSwitch"
                                            AutomationProperties.Name="カウント"
                                            OffContent="カウントなし"
                                            OnContent="1 小節カウントする"
                                            Toggled="RecCountIn_Toggled" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="テンポ" />
                                            <NumberBox
                                                x:Name="RecBpmBox"
                                                Grid.Column="1"
                                                AutomationProperties.Name="カウントのテンポ"
                                                LargeChange="10"
                                                Maximum="240"
                                                Minimum="40"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Inline"
                                                Value="120"
                                                ValueChanged="RecBpm_Changed" />
                                        </Grid>
                                        <ToggleSwitch
                                            x:Name="RecGuideWhileSwitch"
                                            AutomationProperties.Name="録音中もガイドを鳴らす"
                                            OffContent="録音前だけ鳴らす"
                                            OnContent="録音中も鳴らす"
                                            Toggled="RecGuideWhile_Toggled" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel Spacing="8">
                                        <local:InfoNote
                                            Title="マイク"
                                            Text="保存は 44.1 kHz、16 bit、モノラルです。先頭の無音は切りません。入力デバイスは、この PC に覚えます。" />
                                        <ComboBox
                                            x:Name="RecDeviceBox"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="入力デバイス"
                                            DisplayMemberPath="Label"
                                            SelectionChanged="RecDevice_Changed" />
                                        <TextBlock
                                            x:Name="RecDeviceError"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                        <ToggleSwitch
                                            x:Name="RecAutoSwitch"
                                            AutomationProperties.Name="停止したら次の未録音へ進む"
                                            OffContent="停止しても行に残る"
                                            OnContent="停止したら次の未録音へ進む"
                                            Toggled="RecAuto_Toggled" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border
                            Grid.Row="2"
                            Padding="12,10,12,12"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        x:Name="RecGuideButton"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="ガイドを聴く"
                                        Click="RecGuide_Click"
                                        Content="ガイドを聴く"
                                        IsEnabled="False"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTipService.ToolTip="ガイド音源があればそれを、無ければガイド音を再生します（F11）" />
                                    <Button
                                        x:Name="RecPlayButton"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="テイクを聴く"
                                        Click="RecPlay_Click"
                                        Content="テイクを聴く"
                                        IsEnabled="False"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTipService.ToolTip="保存した WAV を再生します（F10）" />
                                    <Button
                                        x:Name="RecPrevButton"
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="前の行"
                                        Click="RecPrev_Click"
                                        Content="前へ"
                                        IsEnabled="False"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTipService.ToolTip="前の行へ移ります（F7）" />
                                    <Button
                                        x:Name="RecMissingButton"
                                        Grid.Row="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="次の未録音"
                                        Click="RecMissing_Click"
                                        Content="次の未録音"
                                        IsEnabled="False"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTipService.ToolTip="次の未録音の行へ移ります（F6）" />
                                    <Button
                                        x:Name="RecNextButton"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="次の行"
                                        Click="RecNext_Click"
                                        Content="次へ"
                                        IsEnabled="False"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTipService.ToolTip="次の行へ移ります（F8）" />
                                </Grid>
                                <Button
                                    x:Name="RecRecordButton"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="録音"
                                    Click="RecRecord_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource ToolbarAccentButtonStyle}"
                                    ToolTipService.ToolTip="録音を開始または停止します（F9）">
                                    <TextBlock x:Name="RecRecordLabel" Text="録音" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <StackPanel
                x:Name="ErrorView"
                MaxWidth="480"
                Padding="24"
                Spacing="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <Viewbox Width="32" Height="32" Margin="0,0,0,8" HorizontalAlignment="Center">
                    <SymbolIcon Symbol="Important" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </Viewbox>
                <TextBlock
                    Text="フォルダを開けませんでした"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="ErrorText"
                    Margin="0,0,0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    MinWidth="160"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="IdleView_Click"
                    Content="フォルダを開く"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="StatusBar"
            Grid.Row="1"
            Padding="16,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="StatusProgress"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="処理の進行状況"
                    IsIndeterminate="True" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border
            x:Name="FileStatusBar"
            Grid.Row="2"
            Padding="16,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="FileProgress"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="解析中ファイルの進行状況"
                    Minimum="0"
                    Maximum="1" />
                <TextBlock
                    x:Name="FileStatusText"
                    Grid.Column="1"
                    MaxWidth="480"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border
            x:Name="LogHost"
            Grid.Row="3"
            Padding="16,4,16,6"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <TextBlock
                x:Name="LogText"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="ログ"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                IsTextSelectionEnabled="True"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Border>
    </Grid>
</Page>
