<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Otoasobi.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Otoasobi"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <x:String x:Key="EditorHelp">上の波形では境界をドラッグして時刻を分けます。音量の下に出る oto.ini のラベルはドラッグできません。右ドラッグ、または選択中の左右キーでスクロールします。</x:String>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolbarAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OverlapValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="OverlapGroupStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverFill.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="PressFill.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Selection.Opacity" Value="1" />
                                            <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="Label.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="FocusRing.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="PointerFocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="HoverFill"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="PressFill"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="Selection"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="FocusRing"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <ContentPresenter
                                x:Name="Label"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <MenuBar VerticalAlignment="Center" Padding="4,0">
                <MenuBarItem Title="ファイル">
                    <MenuFlyoutItem
                        x:Name="OpenMenuItem"
                        Text="フォルダを開く"
                        Click="IdleView_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="WriteMenuItem"
                        Text="oto.iniを作成"
                        Click="WriteOto_Click"
                        IsEnabled="False">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="終了" Click="Exit_Click" />
                </MenuBarItem>
                <MenuBarItem Title="解析">
                    <MenuFlyoutItem
                        x:Name="ReanalyzeMenuItem"
                        Text="再解析"
                        Click="Reanalyze_Click"
                        IsEnabled="False" />
                    <MenuFlyoutItem
                        x:Name="ReanalyzeSelectedMenuItem"
                        Text="選択した音声だけを再解析"
                        Click="ReanalyzeSelected_Click"
                        IsEnabled="False" />
                </MenuBarItem>
            </MenuBar>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel
                x:Name="IdleView"
                MaxWidth="480"
                Padding="24"
                Spacing="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    Text="オトアソビ"
                    Style="{StaticResource TitleTextBlockStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    Margin="0,0,0,16"
                    Text="OTOasobi"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    Margin="0,0,0,8"
                    Text="フォルダを開くと編集画面に入ります。保存データがあるときは、その区間を読み込みます。無いときは、解析してから区間を直せます。フォルダをこのウィンドウへドロップしても開けます。"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    MinWidth="200"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="IdleView_Click"
                    Content="既存のフォルダを選ぶ"
                    Style="{StaticResource AccentButtonStyle}" />
                <StackPanel
                    x:Name="RecentSection"
                    Margin="0,28,0,0"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Left"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="最近使用したフォルダ" />
                    <Border Padding="4" Style="{StaticResource PanelCardStyle}">
                        <ListView
                            x:Name="RecentList"
                            MaxHeight="280"
                            AutomationProperties.Name="最近使用したフォルダ"
                            IsItemClickEnabled="True"
                            ItemClick="RecentList_ItemClick"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,2" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <SymbolIcon
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Symbol="Folder" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{Binding Path}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel
                x:Name="BusyView"
                MaxWidth="360"
                Spacing="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <ProgressRing
                    x:Name="BusyRing"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="解析しています"
                    IsActive="False" />
                <TextBlock
                    x:Name="BusyTitle"
                    Text="読み込んでいます"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <ProgressBar
                    x:Name="BusyProgress"
                    AutomationProperties.Name="解析の進行状況"
                    Minimum="0"
                    Maximum="1" />
                <TextBlock
                    x:Name="BusyCount"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid x:Name="EditorView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="FolderLabel"
                    Grid.Row="0"
                    Margin="16,8,16,0"
                    AutomationProperties.Name="開いているフォルダ"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />

                <ScrollViewer
                    x:Name="NoticeHost"
                    Grid.Row="1"
                    MaxHeight="132"
                    Margin="16,8,16,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <InfoBar
                        x:Name="NoticeBar"
                        HorizontalAlignment="Stretch"
                        IsClosable="True"
                        IsOpen="False"
                        Closed="NoticeBar_Closed" />
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Padding="16,12,16,8"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="ファイル" />
                                    <TextBlock
                                        x:Name="FileCount"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                            </Border>
                            <ListView
                                x:Name="FileList"
                                Grid.Row="1"
                                AutomationProperties.Name="ファイル一覧"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="FileList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="FileTitle"
                            Margin="16,8,16,8"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <local:SpanEditor
                            x:Name="Editor"
                            Grid.Row="1"
                            Margin="12,0,12,4"
                            AutomationProperties.Name="波形と区間"
                            AutomationProperties.HelpText="{StaticResource EditorHelp}" />
                    </Grid>
                    <Border
                        Grid.Column="2"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Padding="12,10"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Border
                                    Padding="3"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="SourceTab"
                                            AutomationProperties.Name="原音修正"
                                            Checked="SideTab_Checked"
                                            Content="原音修正"
                                            GroupName="EditorSideTab"
                                            Style="{StaticResource SegmentButtonStyle}" />
                                        <RadioButton
                                            x:Name="OtoTab"
                                            Grid.Column="1"
                                            AutomationProperties.Name="oto調整"
                                            Checked="SideTab_Checked"
                                            Content="oto調整"
                                            GroupName="EditorSideTab"
                                            IsChecked="True"
                                            Style="{StaticResource SegmentButtonStyle}" />
                                    </Grid>
                                </Border>
                            </Border>
                            <Grid Grid.Row="1">
                                <ContentControl
                                    x:Name="ConfigBody"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <StackPanel Padding="12,12,12,12" Spacing="10">
                                                <Border
                                                    Padding="3"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <Grid ColumnSpacing="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton
                                                            x:Name="OtoModeStandalone"
                                                            AutomationProperties.Name="単独音"
                                                            Checked="OtoMode_Checked"
                                                            Content="単独音"
                                                            GroupName="OtoMode"
                                                            IsChecked="True"
                                                            Style="{StaticResource SegmentButtonStyle}" />
                                                        <RadioButton
                                                            x:Name="OtoModeRenzoku"
                                                            Grid.Column="1"
                                                            AutomationProperties.Name="連続音"
                                                            Checked="OtoMode_Checked"
                                                            Content="連続音"
                                                            GroupName="OtoMode"
                                                            Style="{StaticResource SegmentButtonStyle}" />
                                                        <RadioButton
                                                            x:Name="OtoModeCvvc"
                                                            Grid.Column="2"
                                                            AutomationProperties.Name="CVVC"
                                                            Checked="OtoMode_Checked"
                                                            Content="CVVC"
                                                            GroupName="OtoMode"
                                                            Style="{StaticResource SegmentButtonStyle}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel x:Name="StandaloneOtoContent" Spacing="10">
                                                <Border Style="{StaticResource PanelCardStyle}">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="プリセット" />
                                                        <DropDownButton
                                                            x:Name="PresetMenu"
                                                            MinHeight="32"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            AutomationProperties.HelpText="プリセット">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    x:Name="PresetNameText"
                                                                    VerticalAlignment="Center"
                                                                    Text="初期値"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    x:Name="PresetDirtyMark"
                                                                    Grid.Column="1"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    AutomationProperties.Name="変更あり"
                                                                    Text="*"
                                                                    ToolTipService.ToolTip="このプリセットから変更しています"
                                                                    Visibility="Collapsed" />
                                                            </Grid>
                                                            <DropDownButton.Flyout>
                                                                <MenuFlyout x:Name="PresetFlyout" />
                                                            </DropDownButton.Flyout>
                                                        </DropDownButton>
                                                        <Button
                                                            HorizontalAlignment="Stretch"
                                                            Click="SavePreset_Click"
                                                            Content="現在の設定を保存"
                                                            Style="{StaticResource ToolbarButtonStyle}"
                                                            ToolTipService.ToolTip="いまのスライダーの値を、名前をつけて保存します" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource PanelCardStyle}">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="区間" />
                                                        <Grid>
                                                            <TextBlock VerticalAlignment="Center" Text="オフセット" />
                                                            <TextBlock
                                                                x:Name="OffsetValue"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="0.000 s" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="OffsetSlider"
                                                            AutomationProperties.Name="オフセット"
                                                            Maximum="0.1"
                                                            Minimum="-0.1"
                                                            StepFrequency="0.001"
                                                            SnapsTo="StepValues"
                                                            Value="0" />
                                                        <Grid>
                                                            <TextBlock VerticalAlignment="Center" Text="子音部" />
                                                            <TextBlock
                                                                x:Name="ConsonantValue"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="0.200 s" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="ConsonantSlider"
                                                            AutomationProperties.Name="子音部"
                                                            Maximum="0.2"
                                                            Minimum="0"
                                                            StepFrequency="0.001"
                                                            SnapsTo="StepValues"
                                                            Value="0.2" />
                                                        <Grid>
                                                            <TextBlock VerticalAlignment="Center" Text="ブランク" />
                                                            <TextBlock
                                                                x:Name="BlankValue"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="0.000 s" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="BlankSlider"
                                                            AutomationProperties.Name="ブランク"
                                                            Maximum="0.1"
                                                            Minimum="-0.1"
                                                            StepFrequency="0.001"
                                                            SnapsTo="StepValues"
                                                            Value="0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource PanelCardStyle}">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="オーバーラップ" />
                                                        <StackPanel x:Name="OverlapList" Spacing="16" />
                                                    </StackPanel>
                                                </Border>
                                                </StackPanel>
                                                <StackPanel
                                                    x:Name="RenzokuOtoContent"
                                                    Visibility="Collapsed" />
                                                <StackPanel
                                                    x:Name="CvvcOtoContent"
                                                    Visibility="Collapsed" />
                                            </StackPanel>
                                        </ScrollViewer>
                                        <Border
                                            Grid.Row="1"
                                            Padding="12,10,12,12"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <StackPanel Spacing="8">
                                                <Button
                                                    x:Name="WriteButton"
                                                    HorizontalAlignment="Stretch"
                                                    Click="WriteOto_Click"
                                                    Style="{StaticResource ToolbarAccentButtonStyle}"
                                                    ToolTipService.ToolTip="直した区間から oto.ini を計算して、フォルダに保存します（Ctrl+S）">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                        <SymbolIcon Symbol="Save" />
                                                        <TextBlock Text="oto.iniを作成" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    HorizontalAlignment="Stretch"
                                                    Click="ResetConfig_Click"
                                                    Content="初期値に戻す"
                                                    Style="{StaticResource ToolbarButtonStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </ContentControl>
                                <Grid x:Name="SourcePanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <local:EffectRack x:Name="Effects" />
                                    <Border
                                        Grid.Row="1"
                                        Padding="12,10,12,12"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0">
                                        <Button
                                            x:Name="ApplyEffectsButton"
                                            HorizontalAlignment="Stretch"
                                            Click="ApplyEffects_Click"
                                            Content="適用"
                                            IsEnabled="False"
                                            Style="{StaticResource ToolbarAccentButtonStyle}"
                                            ToolTipService.ToolTip="original の音声に、オンのエフェクトをかけて、フォルダ直下の音声を上書きします。解析データは消えます。" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <StackPanel
                x:Name="ErrorView"
                MaxWidth="480"
                Padding="24"
                Spacing="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <Viewbox Width="32" Height="32" Margin="0,0,0,8" HorizontalAlignment="Center">
                    <SymbolIcon Symbol="Important" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </Viewbox>
                <TextBlock
                    Text="フォルダを開けませんでした"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="ErrorText"
                    Margin="0,0,0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    MinWidth="160"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="IdleView_Click"
                    Content="フォルダを開く"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="StatusBar"
            Grid.Row="2"
            Padding="16,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="StatusProgress"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="処理の進行状況"
                    IsIndeterminate="True" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border
            x:Name="FileStatusBar"
            Grid.Row="3"
            Padding="16,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="FileProgress"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="解析中ファイルの進行状況"
                    Minimum="0"
                    Maximum="1" />
                <TextBlock
                    x:Name="FileStatusText"
                    Grid.Column="1"
                    MaxWidth="480"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Page>
