                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Label="サンプル"
                                                Text="[Sample] で再生する原音です。ランダムのときは空欄になります。" />
                                        </Grid>
                                        <ComboBox
                                            x:Name="BankSampleBox"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="サンプルの原音"
