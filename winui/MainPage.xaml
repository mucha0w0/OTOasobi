                                            PlaceholderText="中の人の名前"
                                            Tag="author"
                                            TextChanged="BankShared_TextChanged" />
                                        <TextBlock Text="配布サイト" />
                                        <TextBox
                                            x:Name="BankWebBox"
                                            MinWidth="0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="配布サイト"
                                            PlaceholderText="https://"
                                            Tag="web"
                                            TextChanged="BankShared_TextChanged" />
                                        <Grid ColumnSpacing="4" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="プロフィール" />
                                            <local:InfoNote
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Label="プロフィール"
                                                Text="「：」または「:」を含む行は、原音のプロパティで優先して表示されます。" />
                                        </Grid>
                                        <StackPanel x:Name="BankProfileHost" Spacing="8" />
                                        <Button
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="プロフィールの行を追加"
