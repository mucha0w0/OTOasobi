<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Otoasobi.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="48">
            <Button
                x:Name="IdleView"
                Content="フォルダを選択またはドラッグ＆ドロップ"
                FontSize="20"
                Padding="28,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="IdleView_Click" />

            <TextBlock
                x:Name="BusyView"
                Text="解析中..."
                FontSize="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="DoneView"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="24"
                Visibility="Collapsed">
                <TextBlock
                    Text="解析が完了しました。解析結果は以下です。"
                    FontSize="22"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center" />
                <Button
                    Content="txtファイルを開く"
                    HorizontalAlignment="Center"
                    Click="OpenTxt_Click" />
                <ScrollViewer
                    x:Name="SkipNoticeHost"
                    MaxWidth="560"
                    MaxHeight="240"
                    HorizontalAlignment="Center"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="SkipNotice"
                        FontSize="16"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />
                </ScrollViewer>
            </StackPanel>

            <TextBlock
                x:Name="ErrorView"
                FontSize="18"
                TextAlignment="Center"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560"
                Tapped="ErrorView_Tapped"
                Visibility="Collapsed" />
        </Grid>

        <Border
            x:Name="StatusBar"
            Grid.Row="1"
            Padding="16,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="StatusProgress"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="1" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14" />
            </Grid>
        </Border>
    </Grid>
</Page>
