<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Otoasobi.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Otoasobi"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <x:String x:Key="EditorHelp">波形では境界をドラッグして時刻を分けます。パネルの境目をドラッグすると、隣との幅や高さが変わります。タイトルをドラッグして、上下左右の印の上で離すと、そのパネルを半分にして差し込みます。端へ寄せると、その先のまとまりごと割って入れます。oto区間の線は左右へドラッグしてその値だけを直せます。直したラベルの横には * が付きます。この * は oto区間だけの印で、oto.ini には書きません。スライダーを動かしても、直した値は変わりません。自動推定の位置まで戻すと消えます。強調中の線は波形にも出て、そこでもドラッグできます。強調中は、波形の子音と母音の境界が半透明になり、ドラッグできません。線のないところをクリックすると、その音素の値を強調し、ほかの音素を半透明にします。重なっている場所ではクリックするたびに次の音素へ移ります。別の音素の波形、スペクトラム、音量をクリックすると解除します。音素のないところをクリックするか、Esc でも解除します。右ドラッグ、Shift＋ホイール、または選択中の左右キーでスクロールします。</x:String>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolbarAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OverlapValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="OverlapGroupStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverFill.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="PressFill.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Selection.Opacity" Value="1" />
                                            <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="Label.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="FocusRing.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="PointerFocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="HoverFill"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="PressFill"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="Selection"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="FocusRing"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <ContentPresenter
                                x:Name="Label"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar
            x:Name="AppMenuBar"
            VerticalAlignment="Center"
            Padding="4,0"
            Visibility="Collapsed">
                <MenuBarItem Title="ファイル">
                    <MenuFlyoutItem
                        x:Name="OpenMenuItem"
                        Text="フォルダを開く"
                        Click="IdleView_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="SaveSettingsMenuItem"
                        AutomationProperties.HelpText="計算方法、スライダー、プリセットを、開いているフォルダに保存します"
                        Click="SaveSettings_Click"
                        IsEnabled="False"
                        Text="設定を保存" />
                    <MenuFlyoutItem
                        x:Name="LoadSettingsMenuItem"
                        AutomationProperties.HelpText="開いているフォルダの設定ファイルを読み込みます"
                        Click="LoadSettings_Click"
                        IsEnabled="False"
                        Text="設定を読み込む" />
                    <MenuFlyoutItem
                        x:Name="WriteMenuItem"
                        Text="oto.iniを作成"
                        Click="WriteOto_Click"
                        IsEnabled="False">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="更新を確認" Click="CheckUpdate_Click" />
                    <MenuFlyoutItem Text="終了" Click="Exit_Click" />
                </MenuBarItem>
                <MenuBarItem Title="解析">
                    <MenuFlyoutItem
                        x:Name="ReanalyzeMenuItem"
                        Text="再解析"
                        Click="Reanalyze_Click"
                        IsEnabled="False" />
                    <MenuFlyoutItem
                        x:Name="ReanalyzeSelectedMenuItem"
                        Text="選択した音声だけを再解析"
                        Click="ReanalyzeSelected_Click"
                        IsEnabled="False" />
                </MenuBarItem>
                <MenuBarItem Title="表示">
                    <ToggleMenuFlyoutItem x:Name="ShowFileItem" Tag="file" Text="ファイル" IsChecked="True" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowWaveItem" Tag="wave" Text="波形" IsChecked="True" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowSpecItem" Tag="spec" Text="スペクトログラム" IsChecked="True" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowLoudItem" Tag="loud" Text="音量" IsChecked="True" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowOtoBandItem" Tag="otoBand" Text="oto区間" IsChecked="True" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowSourceItem" Tag="source" Text="原音修正" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowOtoItem" Tag="oto" Text="oto調整" IsChecked="True" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowOtoParamsItem" Tag="otoParams" Text="原音パラメータ" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowFrqItem" Tag="frq" Text=".frq生成" Click="PaneMenu_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem x:Name="LayoutTemplateMenu" Text="配置テンプレート" />
                    <MenuFlyoutItem Text="いまの配置をテンプレートとして保存" Click="SaveLayoutTemplate_Click" />
                    <MenuFlyoutSubItem x:Name="DeleteLayoutTemplateMenu" Text="配置テンプレートを削除" IsEnabled="False" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="配置を初期状態に戻す" Click="ResetLayout_Click" />
                </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="0">
            <StackPanel
                x:Name="IdleView"
                MaxWidth="480"
                Padding="24"
                Spacing="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <local:InfoNote
                    Label="オトアソビ"
                    Text="フォルダを開くと編集画面に入ります。保存データがあるときは、その区間を読み込みます。無いときは、解析してから区間を直せます。フォルダをこのウィンドウへドロップしても開けます。"
                    TextAlignment="Center">
                    <local:InfoNote.Header>
                        <StackPanel Spacing="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="オトアソビ"
                                TextAlignment="Center" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="OTOasobi"
                                TextAlignment="Center" />
                        </StackPanel>
                    </local:InfoNote.Header>
                </local:InfoNote>
                <Button
                    MinWidth="200"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="IdleView_Click"
                    Content="既存のフォルダを選ぶ"
                    Style="{StaticResource AccentButtonStyle}" />
                <StackPanel
                    x:Name="RecentSection"
                    Margin="0,28,0,0"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Left"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="最近使用したフォルダ" />
                    <Border Padding="4" Style="{StaticResource PanelCardStyle}">
                        <ListView
                            x:Name="RecentList"
                            MaxHeight="280"
                            AutomationProperties.Name="最近使用したフォルダ"
                            IsItemClickEnabled="True"
                            ItemClick="RecentList_ItemClick"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,2" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <SymbolIcon
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Symbol="Folder" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{Binding Path}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel
                x:Name="BusyView"
                MaxWidth="360"
                Spacing="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <ProgressRing
                    x:Name="BusyRing"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="解析しています"
                    IsActive="False" />
                <TextBlock
                    x:Name="BusyTitle"
                    Text="読み込んでいます"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <ProgressBar
                    x:Name="BusyProgress"
                    AutomationProperties.Name="解析の進行状況"
                    Minimum="0"
                    Maximum="1" />
                <TextBlock
                    x:Name="BusyCount"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid x:Name="EditorView" Visibility="Collapsed">
                <local:EditorDock x:Name="Dock" />
                <Grid x:Name="PaneHolder" Visibility="Collapsed">
                    <Border x:Name="FilePane">
                        <ListView
                            x:Name="FileList"
                            AutomationProperties.Name="ファイル一覧"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionChanged="FileList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <Grid x:Name="WavePane">
                        <Grid x:Name="WaveHost" />
                    </Grid>
                    <Grid x:Name="SpecHost" />
                    <Grid x:Name="LoudHost" />
                    <Grid x:Name="OtoBandHost" />
                    <local:OtoParamTable x:Name="OtoParams" />
                    <local:SpanEditor
                        x:Name="Editor"
                        Visibility="Collapsed"
                        AutomationProperties.Name="波形と区間"
                        AutomationProperties.HelpText="{StaticResource EditorHelp}" />
                    <Grid x:Name="OtoPane">
                                <ContentControl
                                    x:Name="ConfigBody"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <StackPanel Padding="12,12,12,12" Spacing="10">
                                                <Border
                                                    Padding="3"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <Grid ColumnSpacing="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton
                                                            x:Name="OtoModeStandalone"
                                                            AutomationProperties.Name="単独音"
                                                            Checked="OtoMode_Checked"
                                                            Content="単独音"
                                                            GroupName="OtoMode"
                                                            IsChecked="True"
                                                            Style="{StaticResource SegmentButtonStyle}" />
                                                        <RadioButton
                                                            x:Name="OtoModeRenzoku"
                                                            Grid.Column="1"
                                                            AutomationProperties.Name="連続音"
                                                            Checked="OtoMode_Checked"
                                                            Content="連続音"
                                                            GroupName="OtoMode"
                                                            Style="{StaticResource SegmentButtonStyle}" />
                                                        <RadioButton
                                                            x:Name="OtoModeCvvc"
                                                            Grid.Column="2"
                                                            AutomationProperties.Name="CVVC"
                                                            Checked="OtoMode_Checked"
                                                            Content="CVVC"
                                                            GroupName="OtoMode"
                                                            Style="{StaticResource SegmentButtonStyle}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel x:Name="StandaloneOtoContent" Spacing="10">
                                                <Border Style="{StaticResource PanelCardStyle}">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="プリセット" />
                                                        <DropDownButton
                                                            x:Name="PresetMenu"
                                                            MinHeight="32"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            AutomationProperties.HelpText="プリセット">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    x:Name="PresetNameText"
                                                                    VerticalAlignment="Center"
                                                                    Text="初期値"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    x:Name="PresetDirtyMark"
                                                                    Grid.Column="1"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    AutomationProperties.Name="変更あり"
                                                                    Text="*"
                                                                    ToolTipService.ToolTip="このプリセットから変更しています"
                                                                    Visibility="Collapsed" />
                                                            </Grid>
                                                            <DropDownButton.Flyout>
                                                                <MenuFlyout x:Name="PresetFlyout" />
                                                            </DropDownButton.Flyout>
                                                        </DropDownButton>
                                                        <Button
                                                            HorizontalAlignment="Stretch"
                                                            Click="SavePreset_Click"
                                                            Content="現在の設定を保存"
                                                            Style="{StaticResource ToolbarButtonStyle}"
                                                            ToolTipService.ToolTip="いまのスライダーの値を、名前をつけて保存します" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource PanelCardStyle}">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="区間" />
                                                        <Grid>
                                                            <TextBlock VerticalAlignment="Center" Text="オフセット" />
                                                            <TextBlock
                                                                x:Name="OffsetValue"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="0.000 s" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="OffsetSlider"
                                                            AutomationProperties.Name="オフセット"
                                                            Maximum="0.1"
                                                            Minimum="-0.1"
                                                            StepFrequency="0.001"
                                                            SnapsTo="StepValues"
                                                            Value="0" />
                                                        <Grid>
                                                            <TextBlock VerticalAlignment="Center" Text="子音部" />
                                                            <TextBlock
                                                                x:Name="ConsonantValue"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="0.200 s" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="ConsonantSlider"
                                                            AutomationProperties.Name="子音部"
                                                            Maximum="0.2"
                                                            Minimum="0"
                                                            StepFrequency="0.001"
                                                            SnapsTo="StepValues"
                                                            Value="0.2" />
                                                        <Grid>
                                                            <TextBlock VerticalAlignment="Center" Text="ブランク" />
                                                            <TextBlock
                                                                x:Name="BlankValue"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="0.000 s" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="BlankSlider"
                                                            AutomationProperties.Name="ブランク"
                                                            Maximum="0.1"
                                                            Minimum="-0.1"
                                                            StepFrequency="0.001"
                                                            SnapsTo="StepValues"
                                                            Value="0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource PanelCardStyle}">
                                                    <StackPanel Spacing="10">
                                                        <local:InfoNote
                                                            Title="オーバーラップ"
                                                            Text="0% は子音の開始、100% は母音の開始です。0% で左へ引いて離すと、その行は秒のスライダーになります。" />
                                                        <StackPanel x:Name="OverlapList" Spacing="16" />
                                                    </StackPanel>
                                                </Border>
                                                </StackPanel>
                                                <StackPanel
                                                    x:Name="RenzokuOtoContent"
                                                    Spacing="10"
                                                    Visibility="Collapsed">
                                                    <Border Style="{StaticResource PanelCardStyle}">
                                                        <StackPanel Spacing="8">
                                                            <local:InfoNote
                                                                Title="無音の直後"
                                                                Text="アンダーバーの無音の直後の音素は、選んだ単独音のプリセットで計算します。" />
                                                            <DropDownButton
                                                                x:Name="RestPresetMenu"
                                                                MinHeight="32"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                AutomationProperties.HelpText="無音の直後に使う単独音のプリセット"
                                                                AutomationProperties.Name="単独音のプリセット">
                                                                <TextBlock
                                                                    x:Name="RestPresetNameText"
                                                                    VerticalAlignment="Center"
                                                                    Text="初期値"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <DropDownButton.Flyout>
                                                                    <MenuFlyout x:Name="RestPresetFlyout" />
                                                                </DropDownButton.Flyout>
                                                            </DropDownButton>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource PanelCardStyle}">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock
                                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                Text="区間" />
                                                            <Grid>
                                                                <TextBlock VerticalAlignment="Center" Text="オフセット" />
                                                                <TextBlock
                                                                    x:Name="RenzokuOffsetValue"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="0.000 s" />
                                                            </Grid>
                                                            <Slider
                                                                x:Name="RenzokuOffsetSlider"
                                                                AutomationProperties.Name="オフセット"
                                                                Maximum="0.1"
                                                                Minimum="-0.1"
                                                                SnapsTo="StepValues"
                                                                StepFrequency="0.001"
                                                                ToolTipService.ToolTip="0 は、その音素の子音と直前の母音の境界から 0.15 秒手前です。子音がないときは、母音と母音の境界から 0.15 秒手前です。マイナスは手前、プラスは後です。"
                                                                Value="0" />
                                                            <Grid>
                                                                <TextBlock VerticalAlignment="Center" Text="子音部" />
                                                                <TextBlock
                                                                    x:Name="RenzokuConsonantValue"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="0.200 s" />
                                                            </Grid>
                                                            <Slider
                                                                x:Name="RenzokuConsonantSlider"
                                                                AutomationProperties.Name="子音部"
                                                                Maximum="0.2"
                                                                Minimum="0"
                                                                SnapsTo="StepValues"
                                                                StepFrequency="0.001"
                                                                ToolTipService.ToolTip="母音の開始から後ろへずらします。幅は 0 から 0.2 秒です。"
                                                                Value="0.2" />
                                                            <Grid>
                                                                <TextBlock VerticalAlignment="Center" Text="ブランク" />
                                                                <TextBlock
                                                                    x:Name="RenzokuBlankValue"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="0.000 s" />
                                                            </Grid>
                                                            <Slider
                                                                x:Name="RenzokuBlankSlider"
                                                                AutomationProperties.Name="ブランク"
                                                                Maximum="0.1"
                                                                Minimum="-0.1"
                                                                SnapsTo="StepValues"
                                                                StepFrequency="0.001"
                                                                ToolTipService.ToolTip="0 は音量の上辺の右端です。プラスは減衰側、マイナスは手前です。"
                                                                Value="0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource PanelCardStyle}">
                                                        <StackPanel Spacing="8">
                                                            <local:InfoNote
                                                                Title="オーバーラップ"
                                                                Text="0% はオフセットの位置、100% はその音素の開始です。音素の開始は、子音と直前の母音の境界です。" />
                                                            <Grid>
                                                                <TextBlock VerticalAlignment="Center" Text="割合" />
                                                                <TextBlock
                                                                    x:Name="RenzokuOverlapValue"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="50%" />
                                                            </Grid>
                                                            <Slider
                                                                x:Name="RenzokuOverlapSlider"
                                                                AutomationProperties.Name="オーバーラップ"
                                                                Maximum="100"
                                                                Minimum="0"
                                                                SnapsTo="StepValues"
                                                                StepFrequency="1"
                                                                ToolTipService.ToolTip="オフセットの位置を 0%、その音素の開始を 100% とした割合です。子音ごとのスライダーはありません。"
                                                                Value="50" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel
                                                    x:Name="CvvcOtoContent"
                                                    Spacing="10"
                                                    Visibility="Collapsed">
                                                    <Border Style="{StaticResource PanelCardStyle}">
                                                        <StackPanel Spacing="8">
                                                            <local:InfoNote
                                                                Title="先頭音素"
                                                                Text="ファイルの先頭と、アンダーバーの無音の直後は、選んだ単独音のプリセットで計算します。あいうえおんは、ファイルの先頭では連続音と同じ計算です。エイリアスは「- さ」の形です。" />
                                                            <DropDownButton
                                                                x:Name="CvvcLeadPresetMenu"
                                                                MinHeight="32"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                AutomationProperties.HelpText="先頭音素に使う単独音のプリセット"
                                                                AutomationProperties.Name="単独音のプリセット">
                                                                <TextBlock
                                                                    x:Name="CvvcLeadPresetNameText"
                                                                    VerticalAlignment="Center"
                                                                    Text="初期値"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <DropDownButton.Flyout>
                                                                    <MenuFlyout x:Name="CvvcLeadPresetFlyout" />
                                                                </DropDownButton.Flyout>
                                                            </DropDownButton>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource PanelCardStyle}">
                                                        <StackPanel Spacing="8">
                                                            <local:InfoNote
                                                                Title="プリセット"
                                                                Text="通常音素と子音音素のスライダーです。単独音のプリセットとは別です。" />
                                                            <DropDownButton
                                                                x:Name="CvvcPresetMenu"
                                                                MinHeight="32"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                AutomationProperties.HelpText="CVVCのプリセット">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        x:Name="CvvcPresetNameText"
                                                                        VerticalAlignment="Center"
                                                                        Text="初期値"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        x:Name="CvvcPresetDirtyMark"
                                                                        Grid.Column="1"
                                                                        Margin="6,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        AutomationProperties.Name="変更あり"
                                                                        Text="*"
                                                                        ToolTipService.ToolTip="このプリセットから変更しています"
                                                                        Visibility="Collapsed" />
                                                                </Grid>
                                                                <DropDownButton.Flyout>
                                                                    <MenuFlyout x:Name="CvvcPresetFlyout" />
                                                                </DropDownButton.Flyout>
                                                            </DropDownButton>
                                                            <Button
                                                                HorizontalAlignment="Stretch"
                                                                Click="SaveCvvcPreset_Click"
                                                                Content="現在の設定を保存"
                                                                Style="{StaticResource ToolbarButtonStyle}"
                                                                ToolTipService.ToolTip="いまの CVVC のスライダーの値を、名前をつけて保存します" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource PanelCardStyle}">
                                                        <StackPanel Spacing="8">
                                                            <local:InfoNote
                                                                Title="通常音素"
                                                                Text="先頭以外で、子音がある音素です。オフセットは子音の開始、先行発声は母音の開始に揃えます。あいうえおんは連続音と同じ計算で、オフセットとオーバーラップは子音音素のスライダーです。エイリアスは、そのモーラのかなです。" />
                                                            <Grid>
                                                                <TextBlock VerticalAlignment="Center" Text="子音部" />
                                                                <TextBlock
                                                                    x:Name="CvvcConsonantValue"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="0.200 s" />
                                                            </Grid>
                                                            <Slider
                                                                x:Name="CvvcConsonantSlider"
                                                                AutomationProperties.Name="通常音素の子音部"
                                                                Maximum="0.2"
                                                                Minimum="0"
                                                                SnapsTo="StepValues"
                                                                StepFrequency="0.001"
                                                                ToolTipService.ToolTip="母音の開始から後ろへずらします。幅は 0 から 0.2 秒です。"
                                                                Value="0.2" />
                                                            <Grid>
                                                                <TextBlock VerticalAlignment="Center" Text="ブランク" />
                                                                <TextBlock
                                                                    x:Name="CvvcBlankValue"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="0.000 s" />
                                                            </Grid>
                                                            <Slider
                                                                x:Name="CvvcBlankSlider"
                                                                AutomationProperties.Name="通常音素のブランク"
                                                                Maximum="0.1"
                                                                Minimum="-0.1"
                                                                SnapsTo="StepValues"
                                                                StepFrequency="0.001"
                                                                ToolTipService.ToolTip="0 は音量の上辺の右端です。プラスは減衰側、マイナスは手前です。"
                                                                Value="0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource PanelCardStyle}">
                                                        <StackPanel Spacing="10">
                                                            <local:InfoNote
                                                                Title="通常音素のオーバーラップ"
                                                                Text="0% はオフセット（子音の開始）、100% は先行発声（母音の開始）です。" />
                                                            <StackPanel x:Name="CvvcOverlapList" Spacing="16" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource PanelCardStyle}">
                                                        <StackPanel Spacing="8">
                                                            <local:InfoNote
                                                                Title="子音音素"
                                                                Text="直前の母音と、いまの子音です。エイリアスは「a sh」の形で、通常音素の前に並びます。先行発声はその子音の開始に揃えます。オフセットとオーバーラップは、あいうえおんにも使います。" />
                                                            <Grid>
                                                                <TextBlock VerticalAlignment="Center" Text="オフセット" />
                                                                <TextBlock
                                                                    x:Name="VcOffsetValue"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="0.000 s" />
                                                            </Grid>
                                                            <Slider
                                                                x:Name="VcOffsetSlider"
                                                                AutomationProperties.Name="子音音素のオフセット"
                                                                Maximum="0.1"
                                                                Minimum="-0.1"
                                                                SnapsTo="StepValues"
                                                                StepFrequency="0.001"
                                                                ToolTipService.ToolTip="0 は、その子音の開始から 0.15 秒手前です。マイナスは手前、プラスは後です。"
                                                                Value="0" />
                                                            <Grid>
                                                                <TextBlock VerticalAlignment="Center" Text="オーバーラップ" />
                                                                <TextBlock
                                                                    x:Name="VcOverlapValue"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="50%" />
                                                            </Grid>
                                                            <Slider
                                                                x:Name="VcOverlapSlider"
                                                                AutomationProperties.Name="子音音素のオーバーラップ"
                                                                Maximum="100"
                                                                Minimum="0"
                                                                SnapsTo="StepValues"
                                                                StepFrequency="1"
                                                                ToolTipService.ToolTip="オフセットの位置を 0%、その子音の開始を 100% とした割合です。"
                                                                Value="50" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource PanelCardStyle}">
                                                        <StackPanel Spacing="10">
                                                            <local:InfoNote
                                                                Title="子音音素の子音部"
                                                                Text="0% は先行発声（子音の開始）、100% はブランクの位置です。" />
                                                            <StackPanel x:Name="VcConsonantList" Spacing="16" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource PanelCardStyle}">
                                                        <StackPanel Spacing="10">
                                                            <local:InfoNote
                                                                Title="子音音素のブランク"
                                                                Text="0% はその子音の開始、100% は終了です。" />
                                                            <StackPanel x:Name="VcBlankList" Spacing="16" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                        <Border
                                            Grid.Row="1"
                                            Padding="12,10,12,12"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <StackPanel Spacing="8">
                                                <Button
                                                    x:Name="WriteButton"
                                                    HorizontalAlignment="Stretch"
                                                    Click="WriteOto_Click"
                                                    Style="{StaticResource ToolbarAccentButtonStyle}"
                                                    ToolTipService.ToolTip="直した区間から oto.ini を計算して、フォルダに保存します（Ctrl+S）">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                        <SymbolIcon Symbol="Save" />
                                                        <TextBlock Text="oto.iniを作成" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </ContentControl>
                    </Grid>
                    <Grid x:Name="SourcePane">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <local:EffectRack x:Name="Effects" />
                        <Border
                            Grid.Row="1"
                            Padding="12,10,12,12"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <Button
                                x:Name="ApplyEffectsButton"
                                HorizontalAlignment="Stretch"
                                Click="ApplyEffects_Click"
                                Content="適用"
                                IsEnabled="False"
                                Style="{StaticResource ToolbarAccentButtonStyle}"
                                ToolTipService.ToolTip="original の音声に、オンのエフェクトをかけて、フォルダ直下の音声を上書きします。解析データは消えます。" />
                        </Border>
                    </Grid>
                    <Grid x:Name="FrqPane">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="12" Spacing="10">
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel Spacing="8">
                                        <local:InfoNote
                                            Title="周波数表"
                                            Text="フォルダ直下の各 WAV と同じ名前で、UTAU 用の .frq を書きます。256 サンプルごとの高さと、有声部分の平均です。原音修正のあとや WAV を差し替えたあとは作り直します。original には書きません。" />
                                        <TextBlock
                                            x:Name="FrqSummary"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="フォルダを開くと、WAV と .frq の件数がここに出ます。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="対象" />
                                        <RadioButton
                                            x:Name="FrqModeAll"
                                            AutomationProperties.Name="全てのfrqファイルを上書きして生成する"
                                            GroupName="FrqScope"
                                            IsChecked="True">
                                            <TextBlock Text="全てのfrqファイルを上書きして生成する" TextWrapping="Wrap" />
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="FrqModeMissing"
                                            AutomationProperties.Name="frqが存在しないファイルだけ生成する"
                                            GroupName="FrqScope">
                                            <TextBlock Text="frqが存在しないファイルだけ生成する" TextWrapping="Wrap" />
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="FrqModeSelected"
                                            AutomationProperties.Name="現在選択中のファイルだけ生成する"
                                            GroupName="FrqScope">
                                            <TextBlock Text="現在選択中のファイルだけ生成する" TextWrapping="Wrap" />
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelCardStyle}">
                                    <StackPanel Spacing="4">
                                        <CheckBox
                                            x:Name="FrqClearPreutterBox"
                                            AutomationProperties.Name="先行発声までを０に統一する"
                                            Content="先行発声までを０に統一する"
                                            IsChecked="False" />
                                        <TextBlock
                                            Margin="28,0,0,0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="これは単独音のときのみオンにしてください。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border
                            Grid.Row="1"
                            Padding="12,10,12,12"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <Button
                                x:Name="WriteFrqButton"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name=".frqを生成"
                                Click="WriteFrq_Click"
                                Content=".frqを生成"
                                IsEnabled="False"
                                Style="{StaticResource ToolbarAccentButtonStyle}"
                                ToolTipService.ToolTip="フォルダ直下の各 WAV の横に .frq を書きます。UTAU の合成が、この高さの表を使います。原音修正のあとや、WAV を差し替えたあとは作り直します。" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <StackPanel
                x:Name="ErrorView"
                MaxWidth="480"
                Padding="24"
                Spacing="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <Viewbox Width="32" Height="32" Margin="0,0,0,8" HorizontalAlignment="Center">
                    <SymbolIcon Symbol="Important" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </Viewbox>
                <TextBlock
                    Text="フォルダを開けませんでした"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="ErrorText"
                    Margin="0,0,0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    MinWidth="160"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="IdleView_Click"
                    Content="フォルダを開く"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="StatusBar"
            Grid.Row="1"
            Padding="16,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="StatusProgress"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="処理の進行状況"
                    IsIndeterminate="True" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border
            x:Name="FileStatusBar"
            Grid.Row="2"
            Padding="16,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="FileProgress"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="解析中ファイルの進行状況"
                    Minimum="0"
                    Maximum="1" />
                <TextBlock
                    x:Name="FileStatusText"
                    Grid.Column="1"
                    MaxWidth="480"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border
            x:Name="LogHost"
            Grid.Row="3"
            Padding="16,4,16,6"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <TextBlock
                x:Name="LogText"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="ログ"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                IsTextSelectionEnabled="True"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Border>
    </Grid>
</Page>
