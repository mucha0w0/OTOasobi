<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Otoasobi.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="48">
        <Button
            x:Name="IdleView"
            Content="フォルダを選択またはドラッグ＆ドロップ"
            FontSize="20"
            Padding="28,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Click="IdleView_Click" />

        <TextBlock
            x:Name="BusyView"
            Text="解析中..."
            FontSize="22"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />

        <StackPanel
            x:Name="DoneView"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="24"
            Visibility="Collapsed">
            <TextBlock
                Text="解析が完了しました。解析結果は以下です。"
                FontSize="22"
                TextAlignment="Center"
                TextWrapping="Wrap"
                HorizontalAlignment="Center" />
            <Button
                Content="txtファイルを開く"
                HorizontalAlignment="Center"
                Click="OpenTxt_Click" />
        </StackPanel>

        <TextBlock
            x:Name="ErrorView"
            FontSize="18"
            TextAlignment="Center"
            TextWrapping="Wrap"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="560"
            Tapped="ErrorView_Tapped"
            Visibility="Collapsed" />
    </Grid>
</Page>
