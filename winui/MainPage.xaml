<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Otoasobi.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Otoasobi"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <x:String x:Key="EditorHelp">音素推定では境界をドラッグして時刻を分けます。パネルの境目をドラッグすると、隣との幅や高さが変わります。タイトルをドラッグして、上下左右の印の上で離すと、そのパネルを半分にして差し込みます。端へ寄せると、その先のまとまりごと割って入れます。oto設定の線は左右へドラッグしてその値だけを直せます。直したラベルの横には * が付きます。この * は oto設定だけの印で、oto.ini には書きません。スライダーを動かしても、直した値は変わりません。自動推定の位置まで戻すと消えます。強調中の線は音素推定にも出て、そこでもドラッグできます。強調中は、音素推定の子音と母音の境界が半透明になり、ドラッグできません。線のないところをクリックすると、その音素の値を強調し、ほかの音素を半透明にします。重なっている場所ではクリックするたびに次の音素へ移ります。別の音素の音素推定、スペクトラム、音量をクリックすると解除します。音素のないところをクリックするか、Esc でも解除します。音素推定、スペクトログラム、音量、oto設定の上ではホイールで前後のファイルへ移ります。ほかのパネルの上では、そのパネルを縦にスクロールします。Ctrl＋ホイールで、ポインタの位置を基準に拡大します。右ドラッグ、Shift＋ホイール、または選択中の左右キーで時間をスクロールします。</x:String>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolbarAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OverlapValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="OverlapGroupStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverFill.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="PressFill.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Selection.Opacity" Value="1" />
                                            <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="Label.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="FocusRing.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="PointerFocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="HoverFill"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="PressFill"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="Selection"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="FocusRing"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <ContentPresenter
                                x:Name="Label"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FrqToolButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource SegmentButtonStyle}">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="FrqOctaveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                            <ContentPresenter
                                x:Name="Label"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                IsHitTestVisible="False" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Face.Background" Value="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Face.Background" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Face.Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                                            <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Face.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="PointerFocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar
            x:Name="AppMenuBar"
            VerticalAlignment="Center"
            Padding="4,0"
            Visibility="Collapsed">
                <MenuBarItem Title="ファイル">
                    <MenuFlyoutItem
                        x:Name="OpenMenuItem"
                        Text="フォルダを開く"
                        Click="IdleView_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="O" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="SaveSettingsMenuItem"
                        AutomationProperties.HelpText="計算方法、スライダー、プリセットを、開いているフォルダに保存します"
                        Click="SaveSettings_Click"
                        IsEnabled="False"
                        Text="設定を保存" />
                    <MenuFlyoutItem
                        x:Name="LoadSettingsMenuItem"
                        AutomationProperties.HelpText="開いているフォルダの設定ファイルを読み込みます"
                        Click="LoadSettings_Click"
                        IsEnabled="False"
                        Text="設定を読み込む" />
                    <MenuFlyoutItem
                        x:Name="WriteMenuItem"
                        Text="oto.iniを生成"
                        Click="WriteOto_Click"
                        IsEnabled="False">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="更新を確認" Click="CheckUpdate_Click" />
                    <MenuFlyoutItem Text="終了" Click="Exit_Click" />
                </MenuBarItem>
                <MenuBarItem Title="編集">
                    <MenuFlyoutItem Text="環境設定" Click="OpenSettings_Click" />
                </MenuBarItem>
                <MenuBarItem Title="解析">
                    <MenuFlyoutItem
                        x:Name="ReanalyzeMenuItem"
                        Text="再解析"
                        Click="Reanalyze_Click"
                        IsEnabled="False" />
                    <MenuFlyoutItem
                        x:Name="ReanalyzeSelectedMenuItem"
                        Text="選択した音声だけを再解析"
                        Click="ReanalyzeSelected_Click"
                        IsEnabled="False" />
                </MenuBarItem>
                <MenuBarItem Title="表示">
                    <ToggleMenuFlyoutItem x:Name="ShowFileItem" Tag="file" Text="ファイルリスト" IsChecked="True" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowWaveItem" Tag="wave" Text="音素推定" IsChecked="True" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowSpecItem" Tag="spec" Text="スペクトログラム" IsChecked="True" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowLoudItem" Tag="loud" Text="音量" IsChecked="True" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowOtoBandItem" Tag="otoBand" Text="oto設定" IsChecked="True" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowSourceItem" Tag="source" Text="エフェクター" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowOtoItem" Tag="oto" Text="oto推定設定" IsChecked="True" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowOtoParamsItem" Tag="otoParams" Text="oto数値表" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowOtoIniItem" Tag="otoIni" Text="oto.ini生成" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowFrqItem" Tag="frq" Text=".frq生成" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowFrqEditItem" Tag="frqEdit" Text="frqエディター" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowBankItem" Tag="bank" Text="音源の各種設定" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowRecListItem" Tag="recList" Text="録音リスト" Click="PaneMenu_Click" />
                    <ToggleMenuFlyoutItem x:Name="ShowRecItem" Tag="rec" Text="録音" Click="PaneMenu_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem x:Name="LayoutTemplateMenu" Text="配置テンプレート" />
                    <MenuFlyoutItem Text="いまの配置をテンプレートとして保存" Click="SaveLayoutTemplate_Click" />
                    <MenuFlyoutSubItem x:Name="DeleteLayoutTemplateMenu" Text="配置テンプレートを削除" IsEnabled="False" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="配置を初期状態に戻す" Click="ResetLayout_Click" />
                </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="0">
            <StackPanel
                x:Name="IdleView"
                MaxWidth="480"
                Padding="24"
                Spacing="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <local:InfoNote
                    Label="オトアソビ"
                    Text="フォルダを開くと編集画面に入ります。保存データがあるときは、その区間を読み込みます。無いときは、解析してから区間を直せます。フォルダをこのウィンドウへドロップしても開けます。"
                    TextAlignment="Center">
                    <local:InfoNote.Header>
                        <StackPanel Spacing="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="オトアソビ"
                                TextAlignment="Center" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="OTOasobi"
                                TextAlignment="Center" />
                        </StackPanel>
                    </local:InfoNote.Header>
                </local:InfoNote>
                <Button
                    MinWidth="200"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Click="IdleView_Click"
                    Content="既存のフォルダを選ぶ"
                    Style="{StaticResource AccentButtonStyle}" />
                <StackPanel
                    x:Name="RecentSection"
                    Margin="0,28,0,0"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Left"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="最近使用したフォルダ" />
                    <Border Padding="4" Style="{StaticResource PanelCardStyle}">
                        <ListView
                            x:Name="RecentList"
                            MaxHeight="280"
                            AutomationProperties.Name="最近使用したフォルダ"
                            IsItemClickEnabled="True"
                            ItemClick="RecentList_ItemClick"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,2" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <SymbolIcon
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Symbol="Folder" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{Binding Path}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel
                x:Name="BusyView"
                MaxWidth="360"
                Spacing="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <ProgressRing
                    x:Name="BusyRing"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="解析しています"
                    IsActive="False" />
                <TextBlock
                    x:Name="BusyTitle"
                    Text="読み込んでいます"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <ProgressBar
                    x:Name="BusyProgress"
                    AutomationProperties.Name="解析の進行状況"
                    Minimum="0"
                    Maximum="1" />
                <TextBlock
                    x:Name="BusyCount"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid x:Name="EditorView" Visibility="Collapsed">
                <local:EditorDock x:Name="Dock" />
                <Grid x:Name="PaneHolder" Visibility="Collapsed">
                    <Border x:Name="FilePane">
                        <ListView
                            x:Name="FileList"
                            AutomationProperties.Name="ファイルリスト"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionChanged="FileList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <Grid x:Name="WavePane">
                        <Grid x:Name="WaveHost" />
                    </Grid>
                    <Grid x:Name="SpecHost" />
                    <Grid x:Name="LoudHost" />
                    <Grid x:Name="OtoBandHost" />
                    <local:OtoParamTable x:Name="OtoParams" />
                    <local:SpanEditor
                        x:Name="Editor"
                        Visibility="Collapsed"
                        AutomationProperties.Name="音素推定と区間"
                        AutomationProperties.HelpText="{StaticResource EditorHelp}" />
                    <Grid x:Name="OtoPane">
                                <ContentControl
                                    x:Name="ConfigBody"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                    <Grid>
                                        <ScrollViewer
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <StackPanel Padding="12,12,12,12" Spacing="10">
                                                <Border
                                                    Padding="3"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <Grid ColumnSpacing="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <RadioButton
                                                            x:Name="OtoModeStandalone"
                                                            AutomationProperties.Name="単独音"
                                                            Checked="OtoMode_Checked"
                                                            Content="単独音"
                                                            GroupName="OtoMode"
                                                            IsChecked="True"
                                                            Style="{StaticResource SegmentButtonStyle}" />
                                                        <RadioButton
                                                            x:Name="OtoModeRenzoku"
                                                            Grid.Column="1"
                                                            AutomationProperties.Name="連続音"
                                                            Checked="OtoMode_Checked"
                                                            Content="連続音"
                                                            GroupName="OtoMode"
                                                            Style="{StaticResource SegmentButtonStyle}" />
                                                        <RadioButton
                                                            x:Name="OtoModeCvvc"
                                                            Grid.Column="2"
                                                            AutomationProperties.Name="CVVC"
                                                            Checked="OtoMode_Checked"
                                                            Content="CVVC"
                                                            GroupName="OtoMode"
                                                            Style="{StaticResource SegmentButtonStyle}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel x:Name="StandaloneOtoContent" Spacing="10">
                                                <Border Style="{StaticResource PanelCardStyle}">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="プリセット" />
                                                        <DropDownButton
                                                            x:Name="PresetMenu"
                                                            MinHeight="32"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            AutomationProperties.HelpText="プリセット">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    x:Name="PresetNameText"
                                                                    VerticalAlignment="Center"
                                                                    Text="初期値"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    x:Name="PresetDirtyMark"
                                                                    Grid.Column="1"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    AutomationProperties.Name="変更あり"
                                                                    Text="*"
                                                                    ToolTipService.ToolTip="このプリセットから変更しています"
                                                                    Visibility="Collapsed" />
                                                            </Grid>
                                                            <DropDownButton.Flyout>
                                                                <MenuFlyout x:Name="PresetFlyout" />
                                                            </DropDownButton.Flyout>
                                                        </DropDownButton>
                                                        <Button
                                                            HorizontalAlignment="Stretch"
                                                            Click="SavePreset_Click"
                                                            Content="現在の設定を保存"
                                                            Style="{StaticResource ToolbarButtonStyle}"
                                                            ToolTipService.ToolTip="いまのスライダーの値を、名前をつけて保存します" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource PanelCardStyle}">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Text="区間" />
                                                        <Grid>
                                                            <TextBlock VerticalAlignment="Center" Text="オフセット" />
                                                            <TextBlock
                                                                x:Name="OffsetValue"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="0.000 s" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="OffsetSlider"
                                                            AutomationProperties.Name="オフセット"
                                                            Maximum="0.1"
                                                            Minimum="-0.1"
                                                            StepFrequency="0.001"
                                                            SnapsTo="StepValues"
                                                            Value="0" />
                                                        <Grid>
                                                            <TextBlock VerticalAlignment="Center" Text="子音部" />
                                                            <TextBlock
                                                                x:Name="ConsonantValue"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Text="0.200 s" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="ConsonantSlider"
                                                            AutomationProperties.Name="子音部"
                                                            Maximum="0.2"
                                                            Minimum="0"
                                                            StepFrequency="0.001"
                                                            SnapsTo="StepValues"
                                                            Value="0.2" />
                                                        <Grid>
