<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Otoasobi.RecordingSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Otoasobi">
    <UserControl.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="12">
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Spacing="8">
                <local:InfoNote
                    Title="入出力"
                    Text="入力は録音するマイク、出力はガイドとテイクの再生先です。この PC に覚えます。保存は 44.1 kHz、16 bit、モノラルです。先頭の無音は切りません。" />
                <TextBlock Text="入力" />
                <ComboBox
                    x:Name="InputBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="入力デバイス"
                    DisplayMemberPath="Label"
                    PlaceholderText="規定のデバイス"
                    SelectionChanged="Device_Changed" />
                <TextBlock Text="出力" />
                <ComboBox
                    x:Name="OutputBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="出力デバイス"
                    DisplayMemberPath="Label"
                    PlaceholderText="規定のデバイス"
                    SelectionChanged="Device_Changed" />
                <TextBlock
                    x:Name="DeviceError"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
