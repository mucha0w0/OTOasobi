<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Otoasobi.OtoParamTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Otoasobi"
    AutomationProperties.Name="原音パラメータ"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="OtoHeadStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="OtoNameStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="OtoCellStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsSpellCheckEnabled" Value="False" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="OtoAliasStyle" TargetType="TextBox" BasedOn="{StaticResource OtoCellStyle}">
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        </Style>
        <Style x:Key="OtoLineStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style x:Key="OtoRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer
            x:Name="TableScroll"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            ZoomMode="Disabled">
            <Grid
                x:Name="Sheet"
                Width="772"
                MinWidth="640"
                MaxWidth="1180"
                HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    x:Name="HeaderGrid"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    PointerWheelChanged="OnShiftWheel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140*" />
                    <ColumnDefinition Width="92*" />
                    <ColumnDefinition Width="84*" />
                    <ColumnDefinition Width="84*" />
                    <ColumnDefinition Width="84*" />
                    <ColumnDefinition Width="92*" />
                    <ColumnDefinition Width="112*" />
                    <ColumnDefinition Width="84*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource OtoLineStyle}">
                    <TextBlock Style="{StaticResource OtoHeadStyle}" Text="音" ToolTipService.ToolTip="WAV の名前" />
                </Border>
                <Border Grid.Column="1" Style="{StaticResource OtoLineStyle}">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource OtoHeadStyle}"
                        Text="左ブランク"
                        ToolTipService.ToolTip="オフセット。ファイル先頭からのミリ秒" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource OtoLineStyle}">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource OtoHeadStyle}"
                        Text="overlap"
                        ToolTipService.ToolTip="オフセットからのミリ秒。前にあるときは負の数" />
                </Border>
                <Border Grid.Column="3" Style="{StaticResource OtoLineStyle}">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource OtoHeadStyle}"
                        Text="先行発声"
                        ToolTipService.ToolTip="オフセットからのミリ秒" />
                </Border>
                <Border Grid.Column="4" Style="{StaticResource OtoLineStyle}">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource OtoHeadStyle}"
                        Text="固定範囲"
                        ToolTipService.ToolTip="子音部。オフセットからのミリ秒" />
                </Border>
                <Border Grid.Column="5" Style="{StaticResource OtoLineStyle}">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource OtoHeadStyle}"
                        Text="右ブランク"
                        ToolTipService.ToolTip="ブランク。オフセットから終端までの時間を、負の数で書く" />
                </Border>
                <Border Grid.Column="6" Style="{StaticResource OtoLineStyle}">
                    <TextBlock
                        Style="{StaticResource OtoHeadStyle}"
                        Text="エイリアス"
                        ToolTipService.ToolTip="oto.ini に書く名前。同じ名前の 2 回目以降には 2、3、… が付く。手で同じ名前にすると、その欄が赤くなる。編集印の * は oto区間に出て、ここにも oto.ini にも入らない" />
                </Border>
                <Border Grid.Column="7" Style="{StaticResource OtoLineStyle}">
                    <TextBlock
                        Style="{StaticResource OtoHeadStyle}"
                        Text="コメント"
                        ToolTipService.ToolTip="メモ。oto.ini には書き出さない" />
                </Border>
            </Grid>
            <ListView
                x:Name="Rows"
                Grid.Row="1"
                ItemContainerStyle="{StaticResource OtoRowStyle}"
                SelectionChanged="Rows_SelectionChanged"
                SelectionMode="Single"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                ScrollViewer.VerticalScrollMode="Enabled">
            <ListView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="Transparent" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="Transparent" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:OtoParamRow">
                    <Grid
                        HorizontalAlignment="Stretch"
                        Background="{x:Bind EmphasisBrush, Mode=OneWay}"
                        PointerPressed="Row_PointerPressed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140*" />
                            <ColumnDefinition Width="92*" />
                            <ColumnDefinition Width="84*" />
                            <ColumnDefinition Width="84*" />
                            <ColumnDefinition Width="84*" />
                            <ColumnDefinition Width="92*" />
                            <ColumnDefinition Width="112*" />
                            <ColumnDefinition Width="84*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OtoLineStyle}">
                            <TextBlock
                                Style="{StaticResource OtoNameStyle}"
                                Text="{x:Bind FileLabel, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind FileName, Mode=OneTime}" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource OtoLineStyle}">
                            <TextBox
                                GotFocus="Cell_GotFocus"
                                PreviewKeyDown="Cell_KeyDown"
                                LostFocus="Cell_LostFocus"
                                Paste="Cell_Paste"
                                Style="{StaticResource OtoCellStyle}"
                                Tag="1"
                                FontWeight="{x:Bind OffsetWeight, Mode=OneWay}"
                                Text="{x:Bind OffsetText, Mode=OneWay}" />
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource OtoLineStyle}">
                            <TextBox
                                GotFocus="Cell_GotFocus"
                                PreviewKeyDown="Cell_KeyDown"
                                LostFocus="Cell_LostFocus"
                                Paste="Cell_Paste"
                                Style="{StaticResource OtoCellStyle}"
                                Tag="2"
                                FontWeight="{x:Bind OverlapWeight, Mode=OneWay}"
                                Text="{x:Bind OverlapText, Mode=OneWay}" />
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource OtoLineStyle}">
                            <TextBox
                                GotFocus="Cell_GotFocus"
                                PreviewKeyDown="Cell_KeyDown"
                                LostFocus="Cell_LostFocus"
                                Paste="Cell_Paste"
                                Style="{StaticResource OtoCellStyle}"
                                Tag="3"
                                FontWeight="{x:Bind PreutterWeight, Mode=OneWay}"
                                Text="{x:Bind PreutterText, Mode=OneWay}" />
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource OtoLineStyle}">
                            <TextBox
                                GotFocus="Cell_GotFocus"
                                PreviewKeyDown="Cell_KeyDown"
                                LostFocus="Cell_LostFocus"
                                Paste="Cell_Paste"
                                Style="{StaticResource OtoCellStyle}"
                                Tag="4"
                                FontWeight="{x:Bind ConsonantWeight, Mode=OneWay}"
                                Text="{x:Bind ConsonantText, Mode=OneWay}" />
                        </Border>
                        <Border Grid.Column="5" Style="{StaticResource OtoLineStyle}">
                            <TextBox
                                GotFocus="Cell_GotFocus"
                                PreviewKeyDown="Cell_KeyDown"
                                LostFocus="Cell_LostFocus"
                                Paste="Cell_Paste"
                                Style="{StaticResource OtoCellStyle}"
                                Tag="5"
                                FontWeight="{x:Bind BlankWeight, Mode=OneWay}"
                                Text="{x:Bind BlankText, Mode=OneWay}" />
                        </Border>
                        <Border
                            Grid.Column="6"
                            Background="{x:Bind AliasBrush, Mode=OneWay}"
                            Style="{StaticResource OtoLineStyle}">
                            <TextBox
                                GotFocus="Cell_GotFocus"
                                PreviewKeyDown="Cell_KeyDown"
                                LostFocus="Cell_LostFocus"
                                Paste="Cell_Paste"
                                Style="{StaticResource OtoAliasStyle}"
                                Tag="6"
                                FontWeight="{x:Bind AliasWeight, Mode=OneWay}"
                                Text="{x:Bind AliasText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind AliasTip, Mode=OneWay}" />
                        </Border>
                        <Border Grid.Column="7" Style="{StaticResource OtoLineStyle}">
                            <TextBox
                                GotFocus="Cell_GotFocus"
                                PreviewKeyDown="Cell_KeyDown"
                                LostFocus="Cell_LostFocus"
                                Paste="Cell_Paste"
                                Style="{StaticResource OtoAliasStyle}"
                                Tag="7"
                                FontWeight="{x:Bind CommentWeight, Mode=OneWay}"
                                Text="{x:Bind CommentText, Mode=OneWay}"
                                ToolTipService.ToolTip="oto.ini には書き出さない" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            </ListView>
            </Grid>
        </ScrollViewer>
        <ScrollBar
            x:Name="VBar"
            Grid.Column="1"
            IndicatorMode="MouseIndicator"
            Orientation="Vertical"
            Scroll="VBar_Scroll"
            VerticalAlignment="Stretch" />
        <TextBlock
            x:Name="EmptyText"
            Grid.Column="0"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsHitTestVisible="False"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="解析すると、oto.ini に出す値がここに出ます。"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
